    {
      "parameters": {
        "promptType": "define",
        "text": "=\nYou are an expert AI recruitment assistant.\n\nEvaluate the following job listing for a fresher BTech Computer Science candidate.\n\nCANDIDATE PROFILE:\n- Education: BTech Computer Science\n- Experience: Fresher / 0 years\n- Technical skills: Python, Java, JavaScript, React, HTML, CSS, FastAPI, SQL, LangChain, RAG, Generative AI, AI Agents, Machine Learning.\n- Preferred roles: AI Engineer, Python Developer, Software Developer, AI Automation Engineer, Graduate Engineer Trainee.\n- Preferred location: Vadodara, Gujarat, India.\n\nJOB LISTING:\nTitle: {{ $json.job_title }}\nCompany: {{ $json.company }}\nLocation: {{ $json.location }}\nDescription: {{ $json.description }}\n\nTASK:\n1. Evaluate how relevant this job is to the candidate.\n2. Check whether a fresher can realistically apply.\n3. Compare the required skills with the candidate's skills.\n4. Identify any experience requirements or location mismatches.\n5. Give a match score from 0 to 100.\n\nReturn your answer in this exact format:\n\nMATCH_SCORE: [number]\nFRESHER_ELIGIBLE: [YES/NO/UNCERTAIN]\nRELEVANT_SKILLS: [comma-separated skills]\nMISSING_SKILLS: [comma-separated skills]\nREASON: [brief explanation]\nRECOMMENDATION: [APPLY/SKIP/REVIEW]\n",
        "messages": {
          "messageValues": []
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1344,
        -192
      ],
      "id": "0a0585fa-d919-454d-982f-8e0945989911",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        1280,
        16
      ],
      "id": "",
      "name": "Google Gemini Chat Model",
      
    },
    {
      "parameters": {
        "jsCode": "\nconst evaluations = $input.all();\nconst originalJobs = $('If1').all();\n\nreturn evaluations.map((item, index) => {\n  const text = item.json.text || \"\";\n  const job = originalJobs[index]?.json || {};\n\n  const score = Number(\n    text.match(/MATCH_SCORE:\\s*(\\d+)/i)?.[1] || 0\n  );\n\n  const eligibility =\n    text.match(/FRESHER_ELIGIBLE:\\s*(YES|NO|UNCERTAIN)/i)?.[1]\n    || \"UNCERTAIN\";\n\n  const relevant =\n    text.match(/RELEVANT_SKILLS:\\s*([\\s\\S]*?)(?=\\\\n|\\\\r|\\n|$)/i)?.[1]?.trim()\n    || \"\";\n\n  const missing =\n    text.match(/MISSING_SKILLS:\\s*([\\s\\S]*?)(?=\\\\n|\\\\r|\\n|$)/i)?.[1]?.trim()\n    || \"\";\n\n  const reason =\n    text.match(/REASON:\\s*([\\s\\S]*?)(?=\\\\n\\s*RECOMMENDATION:|\\n\\s*RECOMMENDATION:|$)/i)?.[1]?.trim()\n    || \"\";\n\n  const recommendation =\n    text.match(/RECOMMENDATION:\\s*(APPLY|SKIP|REVIEW)/i)?.[1]\n    || \"REVIEW\";\n\n  return {\n    json: {\n      job_title: job.job_title || \"\",\n      company: job.company || \"\",\n      location: job.location || \"\",\n      salary_min: job.salary_min ?? \"\",\n      salary_max: job.salary_max ?? \"\",\n      match_score: score,\n      fresher_eligible: eligibility,\n      relevant_skills: relevant,\n      missing_skills: missing,\n      reason: reason,\n      recommendation: recommendation,\n      job_url: job.job_url || \"\"\n    }\n  };\n});\n"
      },
